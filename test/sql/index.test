# name: test/sql/index.test
# description: CREATE INDEX builds AVET entries; filters on indexed columns and id narrow the scan but stay exact
# group: [mnemonicdb]

require mnemonicdb

statement ok
ATTACH '{TEST_DIR}/index.mnemonic' AS d (TYPE mnemonicdb)

statement ok
CREATE TABLE d.person (name VARCHAR, email VARCHAR UNIQUE, age INTEGER, score DOUBLE, tags VARCHAR[])

statement ok
INSERT INTO d.person (name, email, age, score) SELECT 'p' || i, 'e' || i, i % 100, i / 7.0 FROM range(5000) t(i)

# tx 4: change some ages so history exists before the index is built
statement ok
UPDATE d.person SET age = 1000 + age WHERE age < 3

# Reference results, computed before any index exists (plain AEVT scans)
statement ok
CREATE TABLE ref_now AS SELECT id, name, age FROM d.person

statement ok
CREATE TABLE ref_then AS SELECT id, name, age FROM d.person AT (VERSION => 3)

statement ok
CREATE INDEX person_age ON d.person (age)

query III
SELECT index_name, table_name, sql FROM duckdb_indexes() WHERE database_name = 'd'
----
person_age	person	CREATE INDEX person_age ON person USING AVET (age);

query TTT
SELECT a.name, a.indexed, a.index FROM d.sys.attributes a WHERE a.index IS NOT NULL
----
age	true	person_age

# Every filter shape gives the same answer as the unindexed reference, now and as of tx 3

query I
SELECT count(*) FROM (SELECT id, name, age FROM d.person WHERE age = 42 EXCEPT ALL SELECT * FROM ref_now WHERE age = 42)
----
0

query I
SELECT (SELECT count(*) FROM d.person WHERE age = 42) = (SELECT count(*) FROM ref_now WHERE age = 42)
----
true

query I
SELECT count(*) FROM (SELECT id, name, age FROM d.person AT (VERSION => 3) WHERE age = 42 EXCEPT ALL SELECT * FROM ref_then WHERE age = 42)
----
0

query I
SELECT (SELECT count(*) FROM d.person AT (VERSION => 3) WHERE age = 42) = (SELECT count(*) FROM ref_then WHERE age = 42)
----
true

