# Unique columns are always indexed
query II
SELECT name, age FROM d.person WHERE email = 'e1234'
----
p1234	34

# id lookups
query I
SELECT name FROM d.person WHERE id = (SELECT id FROM ref_now WHERE name = 'p77')
----
p77

query I
SELECT count(*) FROM d.person WHERE id IN (SELECT id FROM ref_now WHERE age = 42)
----
50

# An id that is not in the table, or not a valid entity id, finds nothing
query I
SELECT count(*) FROM d.person WHERE id = 12345
----
0

query I
SELECT count(*) FROM d.person WHERE id = 18446744073709551615
----
0

# Writes after the index exists maintain it, including history
statement ok
UPDATE d.person SET age = 77777 WHERE name = 'p5'

query II
SELECT name, age FROM d.person WHERE age = 77777
----
p5	77777

query I
SELECT count(*) FROM d.person WHERE age = 5
----
49

query I
SELECT count(*) FROM d.person AT (VERSION => 5) WHERE age = 5
----
50

statement ok
DELETE FROM d.person WHERE age = 77777

query I
SELECT count(*) FROM d.person WHERE age = 77777
----
0

# Index state is visible inside the creating transaction and gone after rollback
statement ok
BEGIN

statement ok
CREATE INDEX person_score ON d.person (score)

query I
SELECT count(*) FROM duckdb_indexes() WHERE database_name = 'd'
----
2

statement ok
ROLLBACK

query I
SELECT count(*) FROM duckdb_indexes() WHERE database_name = 'd'
----
1

statement error
CREATE INDEX person_age ON d.person (score)
----
already exists

statement ok
CREATE INDEX IF NOT EXISTS person_age ON d.person (score)

statement error
CREATE INDEX person_age2 ON d.person (age)
----
already indexed

statement error
CREATE INDEX bad ON d.person (age, score)
----
exactly one column

statement error
CREATE INDEX bad ON d.person ((age + 1))
----
exactly one column

statement error
CREATE UNIQUE INDEX bad ON d.person (score)
----
UNIQUE or PRIMARY KEY column constraint

statement error
CREATE INDEX bad ON d.person (id)
----
needs no index

# Indexes persist
statement ok
DETACH d

statement ok
ATTACH '{TEST_DIR}/index.mnemonic' AS d (TYPE mnemonicdb)

query I
SELECT index_name FROM duckdb_indexes() WHERE database_name = 'd'
----
person_age

query I
SELECT count(*) FROM d.person WHERE age BETWEEN 10 AND 12
----
150

statement ok
DROP INDEX d.person_age

query I
SELECT count(*) FROM duckdb_indexes() WHERE database_name = 'd'
----
0

statement error
DROP INDEX d.person_age
----
does not exist

statement ok
DROP INDEX IF EXISTS d.person_age

# Filters still work without the index
query I
SELECT count(*) FROM d.person WHERE age BETWEEN 10 AND 12
----
150

statement ok
CREATE INDEX person_age ON d.person (age)

query I
SELECT count(*) FROM d.person WHERE age BETWEEN 10 AND 12
----
150

query I
SELECT count(*) FROM d.person AT (VERSION => 3) WHERE age = 5
----
50
