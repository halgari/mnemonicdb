# Fused join with a driving filter on one side
statement ok
CREATE TABLE ref_join AS SELECT r.name, r.age, a.balance FROM ref r JOIN (SELECT id, balance FROM d.account) a ON a.id = r.id

query I
SELECT CASE WHEN (SELECT count(*) FROM (SELECT p.name, p.age, a.balance FROM d.person p JOIN d.account a ON a.id = p.id WHERE p.age > 20
        EXCEPT ALL SELECT * FROM ref_join WHERE age > 20)) = 0 THEN 'match' ELSE 'MISMATCH' END
