        AND (SELECT count(*) FROM (SELECT name, tags FROM ref_then WHERE age > 40 OR age IS NULL EXCEPT ALL SELECT name, tags FROM d.person AT (VERSION => 4) WHERE age > 40 OR age IS NULL)) = 0
       THEN 'match' ELSE 'MISMATCH' END
