# name: test/sql/projection_pushdown.test
# description: A NULL-rejecting filter lets a scan read only the filtered and projected columns; results match a full scan
# group: [sql]

require mnemonicdb

statement ok
ATTACH '{TEST_DIR}/projection.mnemonic' AS d (TYPE mnemonicdb)

statement ok
CREATE TABLE d.person (name VARCHAR, age INTEGER, tags VARCHAR[], score DOUBLE)

statement ok
CREATE TABLE d.account (balance INTEGER)

# Entities with every combination of present and absent columns
# tx 4
statement ok
INSERT INTO d.person (name, age, tags, score)
SELECT CASE WHEN i % 3 <> 0 THEN 'n' || i END, CASE WHEN i % 4 <> 0 THEN i % 50 END,
       CASE WHEN i % 5 = 0 THEN ['a', 'b'] WHEN i % 5 = 1 THEN ['c'] END, CASE WHEN i % 2 = 0 THEN i / 2.0 END
FROM range(3000) t(i)

statement ok
INSERT INTO d.account (id, balance) SELECT id, 7 FROM d.person WHERE name LIKE 'n1%'

statement ok
UPDATE d.person SET age = NULL WHERE age = 30

statement ok
UPDATE d.person SET tags = list_append(tags, 'z') WHERE age = 31

statement ok
CREATE INDEX person_age ON d.person (age)

# Reference copies, read without any filter (full membership)
statement ok
CREATE TABLE ref AS SELECT * FROM d.person

statement ok
CREATE TABLE ref_then AS SELECT * FROM d.person AT (VERSION => 4)

query I
SELECT CASE WHEN (SELECT count(*) FROM (SELECT count(*) FROM d.person WHERE age > 10 EXCEPT ALL SELECT count(*) FROM ref WHERE age > 10)) = 0
        AND (SELECT count(*) FROM (SELECT count(*) FROM ref WHERE age > 10 EXCEPT ALL SELECT count(*) FROM d.person WHERE age > 10)) = 0
       THEN 'match' ELSE 'MISMATCH' END
----
match

query I
SELECT CASE WHEN (SELECT count(*) FROM (SELECT count(*) FROM d.person AT (VERSION => 4) WHERE age > 10 EXCEPT ALL SELECT count(*) FROM ref_then WHERE age > 10)) = 0
        AND (SELECT count(*) FROM (SELECT count(*) FROM ref_then WHERE age > 10 EXCEPT ALL SELECT count(*) FROM d.person AT (VERSION => 4) WHERE age > 10)) = 0
       THEN 'match' ELSE 'MISMATCH' END
----
match

