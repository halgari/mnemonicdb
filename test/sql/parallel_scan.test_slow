# name: test/sql/parallel_scan.test_slow
# description: Parallel scans (entity ranges and candidate slices) return exactly what a single-threaded scan does
# group: [sql]

require mnemonicdb

statement ok
ATTACH '{TEST_DIR}/parallel.mnemonic' AS d (TYPE mnemonicdb)

statement ok
CREATE TABLE d.person (name VARCHAR, age INTEGER, score DOUBLE, tags VARCHAR[])

statement ok
CREATE TABLE d.account (balance BIGINT)

# tx 3
statement ok
INSERT INTO d.person (name, age, score, tags) SELECT 'p' || i, i % 1000, i / 3.0, CASE WHEN i % 5 = 0 THEN ['x', 'y' || (i % 3)] END FROM range(250000) t(i)

statement ok
INSERT INTO d.account (id, balance) SELECT id, age * 2 FROM d.person WHERE age % 3 = 0

statement ok
UPDATE d.person SET score = -score WHERE age % 7 = 0

statement ok
DELETE FROM d.person WHERE age % 11 = 0

statement ok
CREATE INDEX person_age ON d.person (age)

statement ok
SET threads = 1

statement ok
CREATE OR REPLACE TABLE single AS SELECT count(*), sum(age), round(sum(score), 3), count(DISTINCT name) FROM d.person

statement ok
SET threads = 8

statement ok
CREATE OR REPLACE TABLE multi AS SELECT count(*), sum(age), round(sum(score), 3), count(DISTINCT name) FROM d.person

query I
SELECT CASE WHEN (SELECT count(*) FROM (SELECT * FROM single EXCEPT ALL SELECT * FROM multi)) = 0 AND (SELECT count(*) FROM (SELECT * FROM multi EXCEPT ALL SELECT * FROM single)) = 0 AND (SELECT count(*) FROM single) > 0 THEN 'match' ELSE 'MISMATCH' END
----
match

