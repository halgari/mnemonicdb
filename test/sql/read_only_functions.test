# name: test/sql/read_only_functions.test
# description: Side-effecting functions (mnemonicdb_add, mnemonicdb_retract, mnemonicdb_compact) refuse to run in a read-only transaction or on a read-only attach (MN-12); read functions keep working
# group: [sql]

require mnemonicdb

statement ok
ATTACH '{TEST_DIR}/read_only_functions.mnemonic' AS d (TYPE mnemonicdb)

statement ok
CREATE TABLE d.person (name VARCHAR, tags VARCHAR[])

statement ok
INSERT INTO d.person (id, name, tags) VALUES (tempid('a'), 'Alice', ['a'])

statement ok
SET VARIABLE alice = (SELECT id FROM d.person WHERE name = 'Alice')

query I
SELECT last_tx FROM mnemonicdb_info('d')
----
3

#
# mnemonicdb_add / mnemonicdb_retract in a READ ONLY transaction: DuckDB's
# read-only error, as CALL and as a table function in a SELECT
#

statement ok
BEGIN TRANSACTION READ ONLY

statement error
CALL mnemonicdb_add('d.person', getvariable('alice'), 'tags', 'b')
----
Cannot write to database ""d"" - transaction is launched in read-only mode

statement ok
ROLLBACK

statement ok
BEGIN TRANSACTION READ ONLY

statement error
SELECT * FROM mnemonicdb_add('d.person', getvariable('alice'), 'tags', 'b')
----
transaction is launched in read-only mode

statement ok
ROLLBACK

statement ok
BEGIN TRANSACTION READ ONLY

statement error
CALL mnemonicdb_retract('d.person', getvariable('alice'), 'tags', 'a')
----
transaction is launched in read-only mode

statement ok
ROLLBACK

statement ok
BEGIN TRANSACTION READ ONLY

statement error
SELECT changed FROM mnemonicdb_retract('d.person', getvariable('alice'), 'tags', 'a') WHERE changed
----
transaction is launched in read-only mode

statement ok
ROLLBACK

# Nothing was written
query II
SELECT tags, (SELECT last_tx FROM mnemonicdb_info('d')) FROM d.person
----
[a]	3

#
# A refused write does not take the writer lock: while con1's read-only
# transaction is still open, con2 can write (a held lock would hang here)
#

statement ok con1
SET VARIABLE alice = (SELECT id FROM d.person WHERE name = 'Alice')

statement ok con1
BEGIN TRANSACTION READ ONLY

statement error con1
SELECT * FROM mnemonicdb_add('d.person', getvariable('alice'), 'tags', 'c')
----
transaction is launched in read-only mode

statement ok con2
INSERT INTO d.person (name) VALUES ('Bob')

statement ok con1
ROLLBACK

query I
SELECT count(*) FROM d.person
----
2

#
# mnemonicdb_compact
#

statement ok
BEGIN TRANSACTION READ ONLY

# The same wording as mnemonicdb_add
statement error
CALL mnemonicdb_compact('d')
----
Cannot write to database ""d"" - transaction is launched in read-only mode

statement ok
ROLLBACK

statement ok
BEGIN TRANSACTION READ ONLY

statement error
SELECT size_after FROM mnemonicdb_compact('d')
----
transaction is launched in read-only mode

statement ok
ROLLBACK

# A statement prepared outside a read-only transaction is still refused when
# executed inside one
statement ok
PREPARE compact_d AS SELECT size_after > 0 FROM mnemonicdb_compact('d')

statement ok
PREPARE add_tag AS SELECT * FROM mnemonicdb_add('d.person', getvariable('alice'), 'tags', 'p')

statement ok
BEGIN TRANSACTION READ ONLY

statement error
EXECUTE compact_d
----
transaction is launched in read-only mode

statement ok
ROLLBACK

statement ok
BEGIN TRANSACTION READ ONLY

statement error
EXECUTE add_tag
----
transaction is launched in read-only mode

statement ok
ROLLBACK

# ... and run normally outside one
query I
EXECUTE compact_d
----
true

query I
EXECUTE add_tag
----
true

query I
SELECT size_after > 0 FROM mnemonicdb_compact('d')
----
true

query I
CALL mnemonicdb_retract('d.person', getvariable('alice'), 'tags', 'p')
----
true

#
# Reads keep working in a READ ONLY transaction
#

statement ok
BEGIN TRANSACTION READ ONLY

query II
SELECT last_tx, read_only FROM mnemonicdb_info('d')
----
6	false

query I
SELECT count(*) > 0 FROM mnemonicdb_history('d', table_name := 'person')
----
true

query I
SELECT count(*) FROM mnemonicdb_tx_changes('d')
----
0

query I
SELECT mnemonicdb_id_partition(tempid('x')) = mnemonicdb_id_partition(tempid('y'))
----
true

query I
SELECT mnemonicdb_decode(mnemonicdb_encode(42::INTEGER), 'INTEGER')
----
42

statement error
SELECT current_tx('d')
----
has not written

statement ok
ROLLBACK

#
# Read-write transactions: unchanged
#

statement ok
BEGIN

query I
CALL mnemonicdb_add('d.person', getvariable('alice'), 'tags', 'b')
----
true

query I
SELECT * FROM mnemonicdb_add('d.person', getvariable('alice'), 'tags', 'c')
----
true

query I
SELECT * FROM mnemonicdb_retract('d.person', getvariable('alice'), 'tags', 'a')
----
true

query I
SELECT current_tx('d') IS NOT NULL
----
true

statement ok
COMMIT

query II
SELECT tags, (SELECT last_tx FROM mnemonicdb_info('d')) FROM d.person WHERE name = 'Alice'
----
[b, c]	7

# A transaction can compact, then write
statement ok
BEGIN

query I
SELECT size_after > 0 FROM mnemonicdb_compact('d')
----
true

query I
CALL mnemonicdb_add('d.person', getvariable('alice'), 'tags', 'd')
----
true

statement ok
COMMIT

query I
SELECT tags FROM d.person WHERE name = 'Alice'
----
[b, c, d]

#
# A datom function is a write like any other: a transaction that read data
# before another transaction committed gets a conflict
#

statement ok con1
BEGIN

query I con1
SELECT count(*) FROM d.person
----
2

statement ok con2
SET VARIABLE alice = (SELECT id FROM d.person WHERE name = 'Alice')

statement ok con2
CALL mnemonicdb_add('d.person', getvariable('alice'), 'tags', 'x')

statement error con1
CALL mnemonicdb_add('d.person', getvariable('alice'), 'tags', 'y')
----
transaction conflict

statement ok con1
ROLLBACK

query I
SELECT tags FROM d.person WHERE name = 'Alice'
----
[b, c, d, x]

#
# One transaction writes to one attached database: a datom function after a
# write to another database is refused (it used to slip past this check)
#

statement ok
ATTACH '{TEST_DIR}/read_only_functions_e.mnemonic' AS e (TYPE mnemonicdb)

statement ok
CREATE TABLE e.t (x INTEGER)

statement ok
INSERT INTO e.t (x) VALUES (0)

statement ok
SET VARIABLE e_row = (SELECT id FROM e.t)

statement ok
BEGIN

statement ok
INSERT INTO e.t (x) VALUES (1)

statement error
CALL mnemonicdb_add('d.person', getvariable('alice'), 'tags', 'z')
----
a single transaction can only write to a single attached database

statement ok
ROLLBACK

statement ok
BEGIN

statement ok
CALL mnemonicdb_add('d.person', getvariable('alice'), 'tags', 'z')

statement error
SELECT * FROM mnemonicdb_add('e.t', getvariable('e_row'), 'x', 1)
----
a single transaction can only write to a single attached database

statement ok
ROLLBACK

statement ok
DETACH e

#
# Table macros: the body is bound when the macro is created, so creating a
# macro over mnemonicdb_add counts as a write to its database (refused in a
# read-only transaction); calling it is refused in one as well
#

statement ok
BEGIN TRANSACTION READ ONLY

statement error
CREATE TEMP MACRO add_tag_macro() AS TABLE SELECT * FROM mnemonicdb_add('d.person', getvariable('alice'), 'tags', 'm')
----
transaction is launched in read-only mode

statement ok
ROLLBACK

statement ok
CREATE TEMP MACRO add_tag_macro() AS TABLE SELECT * FROM mnemonicdb_add('d.person', getvariable('alice'), 'tags', 'm')

statement ok
BEGIN TRANSACTION READ ONLY

statement error
SELECT * FROM add_tag_macro()
----
transaction is launched in read-only mode

statement ok
ROLLBACK

query I
SELECT * FROM add_tag_macro()
----
true

#
# A commit assertion fails a datom function's commit with its own message
#

statement ok
INSERT INTO d.sys.assertions (name, query) VALUES ('at_most_five_tags', 'SELECT name, len(tags) FROM person WHERE len(tags) > 5')

statement error
CALL mnemonicdb_add('d.person', getvariable('alice'), 'tags', 'too-many')
----
assertion "at_most_five_tags" failed (1 row): (Alice, 6)

statement ok
BEGIN

statement ok
CALL mnemonicdb_add('d.person', getvariable('alice'), 'tags', 'too-many')

statement error
COMMIT
----
assertion "at_most_five_tags" failed (1 row): (Alice, 6)

query I
SELECT len(tags) FROM d.person WHERE name = 'Alice'
----
5

#
# Read-only attach: DuckDB's error for a read-only database
#

statement ok
DETACH d

statement ok
ATTACH '{TEST_DIR}/read_only_functions.mnemonic' AS d (TYPE mnemonicdb, READ_ONLY)

statement error
CALL mnemonicdb_add('d.person', getvariable('alice'), 'tags', 'e')
----
Cannot execute statement of type "CALL" on database "d" which is attached in read-only mode!

statement error
SELECT * FROM mnemonicdb_retract('d.person', getvariable('alice'), 'tags', 'b')
----
attached in read-only mode

# The same wording as DuckDB's (and so mnemonicdb_add's)
statement error
CALL mnemonicdb_compact('d')
----
Cannot execute statement of type "mnemonicdb_compact" on database "d" which is attached in read-only mode!

query I
SELECT tags FROM d.person WHERE name = 'Alice'
----
[b, c, d, m, x]
