# Results are not trivially empty
query I
SELECT count(*) FROM d.person p JOIN d.account a ON a.id = p.id LEFT JOIN d.address c ON c.id = p.id
----
1440

# Plans: id joins become one scan; anything else keeps its join
query II
EXPLAIN SELECT p.name, a.balance, c.city FROM d.person p JOIN d.account a ON a.id = p.id LEFT JOIN d.address c ON c.id = p.id
----
physical_plan	<!REGEX>:.*Join.*

query II
EXPLAIN SELECT p.name, a.balance FROM d.person p JOIN d.account a ON a.balance = p.age
----
physical_plan	<REGEX>:.*Hash Join.*

query II
EXPLAIN SELECT p.name, a.balance FROM d.person p AT (VERSION => 6) JOIN d.account a ON a.id = p.id
----
physical_plan	<REGEX>:.*Hash Join.*

query II
EXPLAIN SELECT p.name, o.label FROM d.person p JOIN d.owns o ON o.owner = p.id
----
physical_plan	<REGEX>:.*Hash Join.*

statement ok
SET mnemonicdb_fuse_scans = false

query II
EXPLAIN SELECT p.name, a.balance FROM d.person p JOIN d.account a ON a.id = p.id
----
physical_plan	<REGEX>:.*Hash Join.*

statement ok
SET mnemonicdb_fuse_scans = true

# DML is never fused (UPDATE / DELETE need a single table's row ids)
statement ok
UPDATE d.account SET balance = 0 FROM d.person p WHERE p.id = account.id AND p.age = 10

query I
SELECT count(*) FROM d.account WHERE balance = 0
----
60
