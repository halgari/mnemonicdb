# name: test/sql/scan_fusion.test
# description: Joins of tables on their entity id are fused into one scan; results match the unfused plan exactly
# group: [sql]

require mnemonicdb

statement ok
ATTACH '{TEST_DIR}/fusion.mnemonic' AS d (TYPE mnemonicdb)

statement ok
CREATE TABLE d.person (name VARCHAR, age INTEGER, email VARCHAR UNIQUE, tags VARCHAR[])

statement ok
CREATE TABLE d.account (balance INTEGER)

statement ok
CREATE TABLE d.address (city VARCHAR)

statement ok
CREATE TABLE d.owns (owner REF, label VARCHAR)

# tx 6
statement ok
INSERT INTO d.person (name, age, email, tags) SELECT 'p' || i, i % 50, 'e' || i, CASE WHEN i % 3 = 0 THEN ['a', 'b'] END FROM range(3000) t(i)

# tx 7
statement ok
INSERT INTO d.account (id, balance) SELECT id, age * 10 FROM d.person WHERE age < 25

# tx 8: change history so AT queries differ
statement ok
UPDATE d.person SET age = age + 100 WHERE age % 7 = 0

statement ok
UPDATE d.account SET balance = balance + 1 WHERE balance % 20 = 0

statement ok
DELETE FROM d.person WHERE age = 3

statement ok
INSERT INTO d.address (id, city) SELECT id, 'c' || (age % 3) FROM d.person WHERE age % 2 = 0

statement ok
INSERT INTO d.owns (owner, label) SELECT id, 'thing of ' || name FROM d.person WHERE age = 5

statement ok
CREATE INDEX person_age ON d.person (age)

# inner
statement ok
SET mnemonicdb_fuse_scans = false

statement ok
CREATE OR REPLACE TABLE unfused AS SELECT p.id, p.name, a.balance FROM d.person p JOIN d.account a ON a.id = p.id

statement ok
SET mnemonicdb_fuse_scans = true

statement ok
CREATE OR REPLACE TABLE fused AS SELECT p.id, p.name, a.balance FROM d.person p JOIN d.account a ON a.id = p.id

query I
SELECT CASE WHEN (SELECT count(*) FROM (SELECT * FROM unfused EXCEPT ALL SELECT * FROM fused)) = 0 AND (SELECT count(*) FROM (SELECT * FROM fused EXCEPT ALL SELECT * FROM unfused)) = 0 THEN 'match' ELSE 'MISMATCH' END
----
match

