    ('a.esp', 'game', [{'layer': 'dlc', 'priority': 1}], 'from/here'::VARCHAR, MAP {'k': 'mods'}),
    ('b.esp', 'mods'::d.core.layer, NULL, union_value(layer := 'dlc'), NULL)

statement ok
INSERT INTO d.mods.plugins (name, layer, feeling) VALUES ('p', 'overrides', 'happy')

statement ok
INSERT INTO d.notes (body, feeling, layer) VALUES ('n', 'sad', 'system')

statement error
INSERT INTO d.core.files (path, layer) VALUES ('c.esp', 'nope')
----
nope

query TTTTT
SELECT path, layer, conds, origin, layers FROM d.core.files ORDER BY path
----
a.esp	game	[{'layer': dlc, 'priority': 1}]	from/here	{k=mods}
b.esp	mods	NULL	dlc	NULL

query TT
SELECT path, union_tag(origin) FROM d.core.files ORDER BY path
----
