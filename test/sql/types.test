# name: test/sql/types.test
# description: Named types: CREATE TYPE as schema data, use in any schema, ENUM append, DROP TYPE, reopen
# group: [sql]

require mnemonicdb

statement ok
ATTACH '{TEST_DIR}/types.mnemonic' AS d (TYPE mnemonicdb)

# tx 2, 3
statement ok
CREATE SCHEMA d.core

statement ok
CREATE SCHEMA d.mods

# tx 4
statement ok
CREATE TYPE d.core.layer AS ENUM ('system', 'game', 'dlc', 'mods', 'overrides', 'generated')

# tx 5: a STRUCT type using another named type
statement ok
CREATE TYPE d.core.cond AS STRUCT(layer d.core.layer, priority INTEGER)

# tx 6
statement ok
CREATE TYPE d.core.source AS UNION(path VARCHAR, layer d.core.layer)

# tx 7: types can live in main too
statement ok
CREATE TYPE d.mood AS ENUM ('happy', 'sad')

statement ok
CREATE TYPE IF NOT EXISTS d.core.layer AS ENUM ('x')

statement error
CREATE TYPE d.core.layer AS ENUM ('x')
----
already exists

statement error
CREATE TYPE d.sys.t AS ENUM ('x')
----
schema "sys" is reserved

statement error
CREATE TYPE d.core.r AS REF
----
cannot be REF

statement error
CREATE TYPE d.core.v AS VARIANT
----
VARIANT

# Stored as schema data: the definition names other named types by their qualified name
query TTTII
SELECT schema, name, definition, mnemonicdb_id_partition(id), mnemonicdb_id_local(id) FROM d.sys.types ORDER BY id
----
core	layer	ENUM('system', 'game', 'dlc', 'mods', 'overrides', 'generated')	4	18
core	cond	STRUCT(layer core.layer, priority INTEGER)	4	19
core	source	UNION(path VARCHAR, layer core.layer)	4	20
main	mood	ENUM('happy', 'sad')	4	21

query TTT
SELECT schema_name, type_name, logical_type FROM duckdb_types() WHERE database_name = 'd' ORDER BY ALL
----
core	cond	STRUCT
core	layer	ENUM
core	source	UNION
main	mood	ENUM

# sys.types is written only by DDL
statement error
INSERT INTO d.sys.types (schema, name, definition) VALUES ('core', 'x', 'INTEGER')
----
only through CREATE TYPE

#
# Named types as column types, in tables of any schema
#

# tx 8, 9, 10
statement ok
CREATE TABLE d.core.files (path VARCHAR PRIMARY KEY, layer d.core.layer, conds d.core.cond[], origin d.core.source, layers MAP(VARCHAR, d.core.layer))

statement ok
CREATE TABLE d.mods.plugins (name VARCHAR PRIMARY KEY, layer d.core.layer, feeling mood)

statement ok
CREATE TABLE d.notes (body VARCHAR, feeling d.main.mood, layer d.core.layer)

query TT
SELECT column_name, data_type FROM duckdb_columns() WHERE database_name = 'd' AND table_name = 'files' ORDER BY column_index
----
id	REF
path	VARCHAR
layer	ENUM('system', 'game', 'dlc', 'mods', 'overrides', 'generated')
conds	STRUCT(layer ENUM('system', 'game', 'dlc', 'mods', 'overrides', 'generated'), priority INTEGER)[]
origin	UNION(path VARCHAR, layer ENUM('system', 'game', 'dlc', 'mods', 'overrides', 'generated'))
layers	MAP(VARCHAR, ENUM('system', 'game', 'dlc', 'mods', 'overrides', 'generated'))

query TT
SELECT column_name, data_type FROM duckdb_columns() WHERE database_name = 'd' AND table_name = 'plugins' ORDER BY column_index
----
id	REF
name	VARCHAR
layer	ENUM('system', 'game', 'dlc', 'mods', 'overrides', 'generated')
feeling	ENUM('happy', 'sad')

query TT
SELECT a.name, a.type FROM d.sys.attributes a JOIN d.sys.tables t ON a.table_id = t.id WHERE t.name = 'files' ORDER BY a.id
----
path	VARCHAR
layer	core.layer
conds	core.cond[]
origin	core."source"
layers	MAP(VARCHAR, core.layer)

