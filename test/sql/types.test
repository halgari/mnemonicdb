#
# Transactions: CREATE TYPE / DROP TYPE roll back, and other connections see a type only after commit
#

statement ok
BEGIN

statement ok
CREATE TYPE h.core.temp AS ENUM ('t')

statement ok
CREATE TABLE h.core.uses_temp (t h.core.temp)

statement error con2
CREATE TABLE h.core.other (t h.core.temp)
----
temp

statement ok
ROLLBACK

statement error
CREATE TABLE h.core.other (t h.core.temp)
----
temp

query I
SELECT count(*) FROM h.sys.types WHERE name = 'temp'
----
0

statement ok
CREATE TYPE h.core.unused AS ENUM ('u')

statement ok
BEGIN

statement ok
DROP TYPE h.core.unused

query I
SELECT count(*) FROM h.sys.types WHERE name = 'unused'
----
0

statement ok
ROLLBACK

query I
SELECT count(*) FROM h.sys.types WHERE name = 'unused'
----
1

statement ok
BEGIN

statement ok
CREATE TYPE h.core.later AS ENUM ('l')

query I con2
SELECT count(*) FROM duckdb_types() WHERE database_name = 'h' AND type_name = 'later'
----
0

statement error con2
CREATE TABLE h.core.too_early (l h.core.later)
----
later

statement ok
COMMIT

query I con2
SELECT count(*) FROM duckdb_types() WHERE database_name = 'h' AND type_name = 'later'
----
1

statement ok con2
CREATE TABLE h.core.uses_later (l h.core.later)

