# Comparing two columns of the same named type
query TT
SELECT f.path, p.name FROM d.core.files f JOIN d.mods.plugins p ON f.layer < p.layer ORDER BY ALL
----
a.esp	p
b.esp	p

#
# Appending ENUM values: CREATE OR REPLACE TYPE with a strict extension
#

# Rejected: removing, reordering or renaming values, or changing a non-ENUM type
statement error
CREATE OR REPLACE TYPE d.core.layer AS ENUM ('system', 'game', 'dlc', 'mods', 'overrides')
----
removes 'generated'

statement error
CREATE OR REPLACE TYPE d.core.layer AS ENUM ('game', 'system', 'dlc', 'mods', 'overrides', 'generated', 'extra')
----
value 1 is 'game' and was 'system'

statement error
CREATE OR REPLACE TYPE d.core.layer AS ENUM ('system', 'game', 'DLC', 'mods', 'overrides', 'generated')
----
values cannot be reordered, renamed or removed

statement error
CREATE OR REPLACE TYPE d.core.layer AS VARCHAR
----
the only supported change to a named type is appending values to an ENUM

statement error
CREATE OR REPLACE TYPE d.core.cond AS STRUCT(layer d.core.layer, priority BIGINT)
----
cannot be redefined

# The same definition again changes nothing and commits nothing
query I
SELECT last_tx FROM mnemonicdb_info('d')
----
14

statement ok
CREATE OR REPLACE TYPE d.core.layer AS ENUM ('system', 'game', 'dlc', 'mods', 'overrides', 'generated')

query I
SELECT last_tx FROM mnemonicdb_info('d')
----
14

# tx 15: append
statement ok
CREATE OR REPLACE TYPE d.core.layer AS ENUM ('system', 'game', 'dlc', 'mods', 'overrides', 'generated', 'patches')

query TT
SELECT name, definition FROM d.sys.types WHERE name = 'layer'
----
layer	ENUM('system', 'game', 'dlc', 'mods', 'overrides', 'generated', 'patches')

# Every column using the type, directly or through cond/source/MAP, sees the new value; old values are unchanged
statement ok
INSERT INTO d.core.files (path, layer, conds, origin, layers) VALUES ('c.esp', 'patches', [{'layer': 'patches', 'priority': 2}], union_value(layer := 'patches'), MAP {'p': 'patches'})

statement ok
INSERT INTO d.mods.plugins (name, layer) VALUES ('q', 'patches')

query TTTTT
SELECT path, layer, conds, origin, layers FROM d.core.files ORDER BY path
----
a.esp	game	[{'layer': dlc, 'priority': 1}]	from/here	{k=mods}
b.esp	mods	NULL	dlc	NULL
c.esp	patches	[{'layer': patches, 'priority': 2}]	patches	{p=patches}

query T
SELECT path FROM d.core.files WHERE layer >= 'mods' ORDER BY path
----
b.esp
c.esp

query T
SELECT path FROM d.core.files WHERE layer = 'patches'
----
c.esp

query TT
SELECT name, layer FROM d.mods.plugins ORDER BY name
----
p	overrides
q	patches

# Time travel reads old data through the current type
query TT
SELECT path, layer FROM d.core.files AT (VERSION => 11) ORDER BY path
----
a.esp	game
b.esp	mods

# The definition has history
query TT
SELECT tx, value::VARCHAR FROM mnemonicdb_history('d', table_name := 'sys.types', column_name := 'definition') WHERE added AND value::VARCHAR LIKE 'ENUM(''system''%' ORDER BY tx
----
4	ENUM('system', 'game', 'dlc', 'mods', 'overrides', 'generated')
15	ENUM('system', 'game', 'dlc', 'mods', 'overrides', 'generated', 'patches')

query T
SELECT definition FROM d.sys.types AT (VERSION => 14) WHERE name = 'layer'
----
ENUM('system', 'game', 'dlc', 'mods', 'overrides', 'generated')

# An append inside a transaction is private until commit, and rolls back
statement ok
BEGIN

statement ok
CREATE OR REPLACE TYPE d.core.layer AS ENUM ('system', 'game', 'dlc', 'mods', 'overrides', 'generated', 'patches', 'tmp')

statement ok
INSERT INTO d.core.files (path, layer) VALUES ('tmp.esp', 'tmp')

statement ok
ROLLBACK

statement error
INSERT INTO d.core.files (path, layer) VALUES ('tmp.esp', 'tmp')
----
tmp

query I
SELECT count(*) FROM d.core.files
----
3

#
# Growing an ENUM past 255 values changes its physical width: stored values are re-encoded
#

statement ok
CREATE TYPE d.core.wide AS ENUM (SELECT 'w' || range::VARCHAR FROM range(255))

statement ok
CREATE TABLE d.core.wides (k VARCHAR PRIMARY KEY, w d.core.wide, ws d.core.wide[])

statement ok
CREATE INDEX w_idx ON d.core.wides (w)

statement ok
INSERT INTO d.core.wides (k, w, ws) VALUES ('a', 'w3', ['w1', 'w254']), ('b', 'w254', ['w0'])

statement ok
UPDATE d.core.wides SET w = 'w200' WHERE k = 'b'

statement ok
CREATE OR REPLACE TYPE d.core.wide AS ENUM (SELECT 'w' || range::VARCHAR FROM range(300))

statement ok
INSERT INTO d.core.wides (k, w, ws) VALUES ('c', 'w299', ['w256', 'w2'])

query TTT
SELECT k, w, ws FROM d.core.wides ORDER BY k
----
a	w3	[w1, w254]
b	w200	[w0]
c	w299	[w2, w256]

query T
SELECT k FROM d.core.wides WHERE w = 'w200'
----
b

# Dictionary order (a string literal would compare as VARCHAR, as in DuckDB)
query TI
SELECT k, enum_code(w) FROM d.core.wides WHERE enum_code(w) > 100 ORDER BY k
----
b	200
c	299

query TTT
SELECT column_name, value::VARCHAR, added FROM mnemonicdb_history('d', table_name := 'core.wides', column_name := 'w') ORDER BY tx, added
----
w	w3	true
w	w254	true
w	w254	false
w	w200	true
w	w299	true

#
# Types from elsewhere
#

# A DuckDB type from another catalog has no identity here: its definition is copied into the column
statement ok
CREATE TYPE memory.main.colour AS ENUM ('red', 'green')

statement ok
CREATE TABLE d.paint (c memory.main.colour)

query T
SELECT a.type FROM d.sys.attributes a JOIN d.sys.tables t ON a.table_id = t.id WHERE t.name = 'paint'
----
ENUM('red', 'green')

# A named type of another MnemonicDB database is refused
statement ok
ATTACH '{TEST_DIR}/types_other.mnemonic' AS e (TYPE mnemonicdb)

statement ok
CREATE TYPE e.main.alien AS ENUM ('x', 'y')

statement error
CREATE TABLE d.bad (a e.main.alien)
----
is not a type of this database

