column "core.files.layer" uses it

statement error
DROP TYPE d.core.cond
----
column "core.files.conds" uses it

statement ok
CREATE TYPE d.core.unused AS STRUCT(a INTEGER, b VARCHAR)

statement ok
CREATE TYPE d.core.wrapper AS STRUCT(u d.core.unused)

statement error
DROP TYPE d.core.unused
----
type "core.wrapper" uses it

statement ok
DROP TYPE d.core.wrapper

statement ok
DROP TYPE d.core.unused

statement error
DROP TYPE d.core.unused
----
does not exist

statement ok
DROP TYPE IF EXISTS d.core.unused

# A schema holding only types can be dropped once they are
statement ok
CREATE SCHEMA d.scratch

statement ok
CREATE TYPE d.scratch.t AS ENUM ('a')

statement error
DROP SCHEMA d.scratch
----
is not empty (0 tables, 1 types)

statement ok
DROP TYPE d.scratch.t

statement ok
DROP SCHEMA d.scratch

#
# ALTER TABLE with named types
#

statement ok
ALTER TABLE d.notes ADD COLUMN extra d.core.cond

statement ok
UPDATE d.notes SET extra = {'layer': 'game', 'priority': 3}

# ENUM to VARCHAR is a safe type change
statement ok
ALTER TABLE d.notes ALTER COLUMN feeling TYPE VARCHAR

