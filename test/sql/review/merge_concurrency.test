# name: test/sql/review/merge_concurrency.test
# description: Review: ON CONFLICT DO UPDATE / MERGE with both matched and unmatched rows
# group: [review]

require mnemonicdb

statement ok
ATTACH '{TEST_DIR}/review_merge.mnemonic' AS d (TYPE mnemonicdb)

statement ok
SET threads = 8

statement ok
CREATE TABLE d.t (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO d.t (k, v) SELECT range * 2, 0 FROM range(2000)

#
# Regression (fixed): DuckDB plans MERGE INTO (and ON CONFLICT, which is
# rewritten to MERGE) as one pipeline per action fed by a broadcast exchange (Catalog::PlanMergeInto,
# duckdb/src/execution/physical_plan/plan_merge_into.cpp). The UPDATE action (MnemonicUpdate) and the
# INSERT action (MnemonicInsert) therefore run on different threads at the same time, and both write the
# transaction's single rocksdb::WriteBatchWithIndex, while the merge input scan reads it.
# Observed: SIGSEGV in SkipList::Insert under TxWriter::Put (both sinks on the stack), a livelock at 200% CPU,
# or "Failed to commit: ... Corruption: unknown WriteBatch tag" at COMMIT. Also races on the tempid map
# and Store::next_local.
# Expected: 4000 rows, 2000 updated + 2000 inserted.
# Fix: override MnemonicCatalog::PlanMergeInto so actions never run concurrently with each other or with
# the input scan (e.g. sinks buffer their input and write in Finalize under a per-transaction mutex),
# or serialize all TxWriter access.
# MnemonicModify::Finalize now run concurrently (both PipelineFinishTask frames seen in one crash). A
# per-transaction mutex around Finalize (or a serialized PlanMergeInto) is still needed.
# WARNING: this test may crash or hang the runner instead of failing cleanly.
#
statement ok
INSERT INTO d.t (k, v) SELECT range, 1 FROM range(4000) ON CONFLICT (k) DO UPDATE SET v = excluded.v

query III
SELECT count(*), sum(v), count(DISTINCT k) FROM d.t
----
4000	4000	4000

statement ok
MERGE INTO d.t USING (SELECT range AS k FROM range(8000)) s ON s.k = d.t.k WHEN MATCHED THEN UPDATE SET v = 2 WHEN NOT MATCHED THEN INSERT (k, v) VALUES (s.k, 3)

query III
SELECT count(*), sum(v), count(DISTINCT k) FROM d.t
----
8000	20000	8000
