# DETACH by another connection while a write transaction is open: the open transaction can still commit
statement ok con1
BEGIN

statement ok con1
INSERT INTO d.t ("My Col") VALUES (2)

statement ok con2
DETACH d

statement ok con1
COMMIT

statement ok con2
ATTACH '{TEST_DIR}/review_schema.mnemonic' AS d (TYPE mnemonicdb)

query I con2
SELECT sum("My Col") FROM d.t
----
3
