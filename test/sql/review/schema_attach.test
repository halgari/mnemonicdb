require mnemonicdb

statement ok
ATTACH '{TEST_DIR}/review_schema.mnemonic' AS d (TYPE mnemonicdb)

statement ok
CREATE TABLE d.t ("My Col" INTEGER, s STRUCT("x""y" INTEGER, "it's" VARCHAR, "order" INTEGER), e ENUM('it''s', 'a"b'), refs REF[], m MAP(VARCHAR, INTEGER[]), u UNION("a b" INTEGER, "C" VARCHAR), arr INTEGER[3], dec DECIMAL(20,4), "select" INTEGER)

statement ok
INSERT INTO d.t ("My Col", s, e, refs, m, u, arr, dec, "select") VALUES (1, {'x"y': 2, 'it''s': 'c', 'order': 3}, 'it''s', [tempid('r')], MAP {'k': [1]}, 'str'::UNION("a b" INTEGER, "C" VARCHAR), [1,2,3], 1.5, 7)

