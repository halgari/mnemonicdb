# name: test/sql/review/halloween_merge.test
# description: Review: same-table INSERT ... SELECT through the k-way merge scan (passes; coverage)
# group: [review]

require mnemonicdb

statement ok
ATTACH '{TEST_DIR}/review_halloween_merge.mnemonic' AS d (TYPE mnemonicdb)

statement ok
CREATE TABLE d.t (x BIGINT, tags BIGINT[])

statement ok
INSERT INTO d.t (x, tags) SELECT range, [range] FROM range(1, 5001)

# New entities are not re-read by the scan feeding the insert
statement ok
INSERT INTO d.t (x) SELECT x FROM d.t

query I
SELECT count(*) FROM d.t
----
10000

statement ok
DELETE FROM d.t WHERE tags IS NULL

# Writes to entities ahead of the scan position are not seen by the merge scan
statement ok
INSERT INTO d.t (id, x, tags) SELECT id + 1, x, tags FROM d.t

query III
SELECT count(*), sum(x), sum(len(tags)) FROM d.t
----
5001	12502501	10000

query I
SELECT count(*) FROM d.t WHERE mnemonicdb_id_local(id) != x + 1 AND mnemonicdb_id_local(id) != 1
----
0
